# Drona ValueChain — JMC Ops Tracker
# Copy to ".env" and fill in your Postgres connection string (the DB link).
#
# Managed providers (Neon / Supabase / RDS) usually require SSL:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Local docker/native:
#   postgresql://postgres:postgres@localhost:5432/jmc

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---- Email alerts (Feature: SMTP) ---------------------------------------
# Leave SMTP_HOST blank to disable email entirely (the app still runs; alerts
# are logged + skipped). Recipients are configured in-app under Settings.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@yourdomain.com
# SMTP_PASS=app-specific-password
# SMTP_SECURE=false          # true for port 465
# ALERT_FROM="Drona ValueChain <alerts@yourdomain.com>"

# Optional runtime overrides (unchanged from before)
# PORT=3000
# NODE_ENV=production
# UPLOAD_DIR=./uploads
